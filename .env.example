# Port exposé sur le NAS (à mettre derrière un reverse proxy HTTPS idéalement)
APP_PORT=3001

# SECRET JWT : à remplacer par une longue chaîne aléatoire
JWT_SECRET=change-me-avec-une-longue-cle-secrete

# Dossier du NAS où la base SQLite sera persistée (doit exister / être créé)
DATA_DIR=/volume1/docker/ssp-app/data